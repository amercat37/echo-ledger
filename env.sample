# Copy to .env and fill in. .env is gitignored and never baked into the image.

# Hugging Face token — REQUIRED for the gated pyannote diarization models.
# Create one at https://huggingface.co/settings/tokens and accept the model terms
# for pyannote/speaker-diarization-community-1.
HF_TOKEN=hf_xxx

# Whisper model + compute settings (defaults shown; override only if needed).
MODEL=large-v3-turbo
DEVICE=cpu
COMPUTE_TYPE=int8
LANGUAGE=en

# Speaker identification (Phase 2).
# MATCH_THRESHOLD: cosine similarity to auto-label a voice (validated ~0.5).
# SPEAKERS_FILE: profile library path (local default speakers.json; container /data/state/...).
MATCH_THRESHOLD=0.5
SPEAKERS_FILE=speakers.json

# Retention: auto-delete source AUDIO older than this many days (transcripts are
# always kept). 0 disables the sweep. Runs once a day in the web service.
RETENTION_DAYS=30

# Logging verbosity: DEBUG | INFO | WARNING | ERROR. INFO is the useful default
# (every job, match score, enroll/retag/delete, retention). DEBUG is very chatty.
LOG_LEVEL=INFO
