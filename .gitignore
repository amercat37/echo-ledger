.env
# ...and any copy of it. `.env` alone does not cover `.env.bak`, `.env.local`
# and friends, and such a file carries a real HF_TOKEN. (`env.sample` is the
# committed template and is unaffected by this pattern.)
.env.*
.venv/
output/
input/
done/
failed/
state/
speakers.json

# Benchmark artifacts = transcripts of a real call. Keep out of history.
bench/
__pycache__/
*.pyc
.DS_Store
scratch_*

# Audio must NEVER be committed (raw voice = biometric). Hard rule.
*.mp3
*.m4a
*.wav
*.flac
*.ogg
*.mp4
*.aac
.pytest_cache/

# Local Compose override: per-machine ports and volume paths. Compose reads it
# automatically if present. Machine-specific by nature — never commit it.
docker-compose.override.yml
